{
  "manifest_version": 3,
  "name": "PixelRuler",
  "description": "Measure element sizes, box model and distances between elements (hold Alt). Toggle with Ctrl+Shift+X. Click to copy.",
  "version": "1.2",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-measurement": {
      "suggested_key": { "default": "Ctrl+Shift+X" },
      "description": "Activate / deactivate measurement"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["content.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
